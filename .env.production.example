# OpenReply — production environment
#
# Copy to `.env.production` and fill in every REQUIRED value:
#
#   cp .env.production.example .env.production
#
# `.env.production` is gitignored. Never commit it, never paste its contents
# into a chat log, an issue, or a support ticket. Rotate any secret that has
# been pasted anywhere it could be logged.
#
# REQUIRED means the stack will not start, sign anyone in, or send a DM
# without it. OPTIONAL means the app runs without it (noted what you lose).

# ---------------------------------------------------------------------------
# REQUIRED — public URL
# ---------------------------------------------------------------------------
# Your public HTTPS URL, with NO trailing slash. This is what magic-link
# emails, OAuth redirects, and tracked links in DMs all point at. It must
# match the domain your reverse proxy serves (see docs/deploy-docker.md)
# and the URLs you register in Meta (redirect + webhook). An http:// URL or
# localhost will NOT work in production: Meta requires public HTTPS for
# webhooks and OAuth, and Auth.js will reject the callback.
NEXTAUTH_URL=https://openreply.example.com

# ---------------------------------------------------------------------------
# REQUIRED — secrets (generate fresh ones; never reuse the dev values)
# ---------------------------------------------------------------------------
# NextAuth session secret. Generate with:  openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret

# Protects the /api/cron routes (token refresh, reel attach, follower
# snapshot). Generate with:  openssl rand -base64 32
# The cron service and the web app must share this value. If CRON_SECRET
# is unset, the routes fall back to NEXTAUTH_SECRET instead.
CRON_SECRET=replace-with-a-strong-random-secret

# Encrypts Instagram tokens and provider credentials at rest. Generate with:
#   openssl rand -hex 32
# The value must be EXACTLY 64 hex characters or the app throws on boot.
# This placeholder is deliberately NOT valid hex — replace it with real
# output from the command above.
# The web app and the worker MUST share this exact value, or every DM send
# fails to decrypt. Losing or changing it later means every connected
# Instagram account has to reconnect.
ENCRYPTION_KEY=replace-with-64-hex-characters-from-openssl-rand-hex-32

# ---------------------------------------------------------------------------
# REQUIRED — Postgres (the `postgres` service in docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# These three values configure the Postgres container itself. DATABASE_URL
# must stay in sync with them: same user, same password, same database,
# host `postgres` (the Compose service name, not localhost).
POSTGRES_DB=openreply
POSTGRES_USER=postgres
# Generate with:  openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-strong-random-postgres-password

# Internal Compose-network URL. Do NOT point this at localhost or at a
# public host: inside the containers, `postgres` resolves to the database
# service. URL-encode special characters in the password if you used any
# (@ becomes %40, # becomes %23, and so on).
DATABASE_URL=postgresql://postgres:replace-with-a-strong-random-postgres-password@postgres:5432/openreply

# ---------------------------------------------------------------------------
# REQUIRED — Redis (the `redis` service in docker-compose.prod.yml)
# ---------------------------------------------------------------------------
# Internal Compose-network URL. `redis` is the Compose service name.
# Must support blocking commands (BullMQ needs them), so an HTTP-only
# Redis will not work.
REDIS_URL=redis://redis:6379

# ---------------------------------------------------------------------------
# REQUIRED — email for magic-link sign-in
# ---------------------------------------------------------------------------
# Login is email magic links only: without working email, nobody can sign
# in. Pick ONE of the two options below.
#
# Option A — Resend (recommended). Create an account at resend.com, verify
# a sender domain, and paste the key. Mailpit is dev-only and is NOT an
# option here.
RESEND_API_KEY=re_replace-with-your-resend-api-key
EMAIL_FROM=OpenReply <login@example.com>
#
# Option B — your own SMTP server. When EMAIL_SERVER is set it takes over
# and RESEND_API_KEY is not needed. URL-encode special characters in the
# user and password (@ becomes %40). Port 465 with smtps:// is implicit
# TLS; port 587 with smtp:// is STARTTLS.
# EMAIL_SERVER=smtps://login%40example.com:password@mail.example.com:465

# ---------------------------------------------------------------------------
# REQUIRED (in practice) — who may sign in
# ---------------------------------------------------------------------------
# Comma-separated allowlist of email addresses that may sign in, case
# insensitive. If you leave this unset, ANYONE who reaches your public URL
# can request a magic link and gets their own workspace. On an instance
# you run for yourself, set this to just your own address(es) before you
# go live.
ALLOWED_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Direct Meta only — OPTIONAL if every account connects through Zernio
# ---------------------------------------------------------------------------
# Your own Meta app. See docs/setup.md ("The Meta app") for where each
# value lives. Leave all four unset if all accounts use Zernio — Zernio
# credentials are saved in Settings, not in environment variables, so
# there are no ZERNIO_* variables to set here.
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
# Any random string. Paste the SAME value into Meta's webhook config as
# the verify token. Generate with:  openssl rand -base64 32
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# ---------------------------------------------------------------------------
# OPTIONAL — tuning (defaults are fine to start)
# ---------------------------------------------------------------------------
# How often the worker sweeps for comments the webhook missed (5 min).
# COMMENT_POLL_INTERVAL_MS=300000
# Max new comments each campaign acts on per sweep. Keep it conservative;
# higher gets closer to Instagram's rate limits.
# COMMENT_POLL_MAX_PER_SWEEP=30
# How far back a sweep considers comments.
# COMMENT_POLL_LOOKBACK_HOURS=72
# Queue-health threshold for /api/health: how many waiting jobs with none
# active counts as a stuck worker.
# HEALTH_STUCK_QUEUE_WAITING=25
